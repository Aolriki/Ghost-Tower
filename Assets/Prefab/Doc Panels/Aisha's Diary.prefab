  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Talvez eu tenha exagarado na senha do porta joias, ent\xE3o por seguran\xE7a,
    para caso eu esque\xE7a, aqui vai uma charada que s\xF3 eu consigo decifrar:\n\n\"O
    primeiro \xE9 aquela que <b>s\xF3 est\xE1 presente</b> em apenas um deles\"\n\n\"No
    meio, <b>a quantidade</b> das minha favoritas\"\n\n\"Por fim, <b>a forma que
    lembra o nome</b> do meu pai\"\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ac18eec29f0c765448317ea3d8d0d8ef, type: 2}
  m_sharedMaterial: {fileID: 2724160109143398708, guid: ac18eec29f0c765448317ea3d8d0d8ef, type: 2}
